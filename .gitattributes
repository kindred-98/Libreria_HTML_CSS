# Auto detect text files and perform LF normalization
* text=auto

# Binarios: sin declararlos, `* text=auto` puede intentar normalizarlos y
# corromperlos (y git los muestra como texto en los diffs). Solo el formato
# importa; el contenido no se toca.
*.zip binary
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
