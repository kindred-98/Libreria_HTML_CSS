# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# No se fija end_of_line: el repositorio normaliza a LF con `* text=auto` de
# .gitattributes, pero en el disco (core.autocrlf=true) los ficheros son CRLF y
# forzar LF desde el editor convertiria media biblioteca de golpe.

[*.md]
# Los bloques de cita y las listas multilínea usan los dos espacios finales.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
